rules_version = '2';

// Paste this into Firebase console -> Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Public profiles: any signed-in user can search them, only the owner can change their own.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // A conversation is visible only to its members.
    match /conversations/{conversationId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
      // Members may update (including leaving, which removes their own uid from the list).
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.members || request.auth.uid in request.resource.data.members);

      match /messages/{messageId} {
        function isMember() {
          return request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
        }
        allow read: if isMember();
        allow create: if isMember() && request.resource.data.senderId == request.auth.uid;
        // The sender may edit their message. The other member may only add the
        // delivered / read receipts (issue #45), nothing else.
        allow update: if isMember() && (
          resource.data.senderId == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredAt', 'readAt'])
        );
        allow delete: if isMember() && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
